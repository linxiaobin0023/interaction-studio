APP_ENV=development
AUTH_MODE=authenticated
# Set true when serving over HTTPS. Required outside development.
SESSION_COOKIE_SECURE=false
APP_HOST=0.0.0.0
APP_PORT=8000
APP_BIND_HOST=127.0.0.1
LOG_LEVEL=INFO

POSTGRES_DB=interaction_studio
POSTGRES_USER=interaction_studio
POSTGRES_PASSWORD=change-me-for-nonlocal-use
DATABASE_URL=postgresql+psycopg://interaction_studio:change-me-for-nonlocal-use@postgres:5432/interaction_studio

REDIS_URL=redis://redis:6379/0

MINIO_ROOT_USER=interaction-studio
MINIO_ROOT_PASSWORD=change-me-for-nonlocal-use
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=interaction-studio-development
S3_ACCESS_KEY=interaction-studio
S3_SECRET_KEY=change-me-for-nonlocal-use

# External providers stay disabled until the data-boundary decision is recorded.
EXTERNAL_INFERENCE_ENABLED=false
ARTIFACT_ROOT=.
WEB_DIST_ROOT=apps/web/dist
OPENAI_API_KEY=
BFL_API_KEY=
